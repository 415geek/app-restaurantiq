{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "app/api/iq/report/[id]/pdf/route.ts": {
      "memory": 1536,
      "maxDuration": 120
    },
    "app/api/funnel/analyze/route.ts": {
      "maxDuration": 180
    },
    "app/api/funnel/full-report/route.ts": {
      "maxDuration": 300
    },
    "app/api/funnel/full-report/worker/route.ts": {
      "maxDuration": 300
    },
    "app/api/funnel/redeem-access-code/route.ts": {
      "maxDuration": 30
    },
    "app/api/iq/report360/[id]/route.ts": {
      "maxDuration": 300
    },
    "app/api/iq/ops/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/iq/ops?task=hubs&metro=sf-bay", "schedule": "0 9 1 * *" },
    { "path": "/api/iq/ops?task=snapshots&metro=sf-bay", "schedule": "0 10 1 * *" },
    { "path": "/api/iq/ops?task=lodes&state=ca&year=2022&counties=06081,06075,06085,06001,06013", "schedule": "0 11 * * 0" },
    { "path": "/api/iq/ops?task=source_gaps&metro=sf-bay", "schedule": "0 12 * * 1" }
  ]
}
